generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------
// SaaS Multi-tenancy Core Models
// -----------------------------------------

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Subscription Plan
  plan               String    @default("free") // free, pro, premium
  active             Boolean   @default(true)
  trialEndsAt        DateTime?
  stripeCustomerId   String?
  subscriptionStatus String?   @default("trialing") // trialing, active, past_due, canceled
  
  // Relations
  users        User[]
  transactions Transaction[]
  products     Product[]
  customers    Customer[]
  sales        Sale[]
  categories   Category[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'PRODUCT' or 'TRANSACTION'
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN") // ADMIN, USER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// -----------------------------------------
// Application Models (Isolados por Company)
// -----------------------------------------

model Transaction {
  id          String   @id @default(uuid())
  type        String   // 'income' or 'expense'
  description String
  amount      Float
  date        DateTime
  category    String?
  createdAt   DateTime @default(now())

  // Multi-tenancy isolation
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
}

model Product {
  id          String   @id @default(uuid())
  name        String
  barcode     String?
  costPrice   Float    @default(0)
  salePrice   Float
  stock       Int      @default(0)
  minStock    Int      @default(5)
  category    String?
  description String?
  imageUrl    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  saleItems   SaleItem[]

  @@index([companyId])
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  email       String?
  phone       String?
  document    String?  // CPF/CNPJ
  creditLimit Float    @default(0)
  
  // Endereço
  cep         String?
  address     String?
  number      String?
  complement  String?
  neighborhood String?
  city        String?
  state       String?
  
  // Observações
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  sales       Sale[]

  @@index([companyId])
}

model Sale {
  id          String   @id @default(uuid())
  saleNumber  Int      @default(autoincrement())
  total       Float
  status      String   @default("COMPLETED") // COMPLETED, PENDING_PAYMENT, CONDICIONAL
  paymentMethod String @default("CASH") // CASH, PIX, CREDIT, DEBIT, CREDIARIO
  installments  Int    @default(1)
  createdAt   DateTime @default(now())

  // Opcional: vinculado a um cliente
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  // Multi-tenancy
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  items       SaleItem[]

  @@index([companyId, status])
}

model SaleItem {
  id          String   @id @default(uuid())
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}
